<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>BitMiracle.LibJpeg.NET</AssemblyName>
    <RootNamespace>BitMiracle.LibJpeg</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Configurations>Debug;Release</Configurations>
    <SignAssembly>false</SignAssembly>
    <OutputPath>..\Result\</OutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants Condition="'$(TargetFramework)'=='netstandard2.0'">TRACE;DEBUG;NETSTANDARD;EXPOSE_LIBJPEG</DefineConstants>
    <DefineConstants Condition="'$(TargetFramework)'=='net90'">TRACE;DEBUG;EXPOSE_LIBJPEG</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants Condition="'$(TargetFramework)'=='netstandard2.0'">TRACE;NETSTANDARD;EXPOSE_LIBJPEG</DefineConstants>
    <DefineConstants Condition="'$(TargetFramework)'=='net90'">TRACE;EXPOSE_LIBJPEG</DefineConstants>
    <OutputPath>..\Result\</OutputPath>
  </PropertyGroup>
  
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\AssemblyVersion.cs" Link="Properties\AssemblyVersion.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>
  
  <PropertyGroup>
    <PreBuildEvent Condition="'$(TargetFramework)'=='net90' And '$(OS)'=='Windows'">cd "$(SolutionDir)"
update_version_info.bat "$(ProjectDir)AssemblyVersion.cs"</PreBuildEvent>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <Optimize>true</Optimize>
  </PropertyGroup>
</Project>
